# Per-data-dir environment file template.
#
# Copy to <data-dir>/config/.env and fill in the values. Everything below is
# authoritative for this data directory and overrides any identical keys set
# in the project-root .env or the shell.
#
# The project-root .env should only set DISCOURSE_DATA_DIR — everything else
# lives here so a single checkout can work with multiple forums by pointing
# DISCOURSE_DATA_DIR at different data dirs.

# ---------------------------------------------------------------------------
# Target forum
# ---------------------------------------------------------------------------

# Base URL of the Discourse instance (no trailing slash).
DISCOURSE_URL=https://discourse.example.com

# ---------------------------------------------------------------------------
# Authentication (one of these three modes; API key preferred)
# ---------------------------------------------------------------------------

# Mode 1 — API key (fastest, no redirects)
# DISCOURSE_API_KEY=
# DISCOURSE_API_USERNAME=

# Mode 2 — browser session cookie (paste the _t cookie value from devtools)
# DISCOURSE_COOKIE=

# Mode 3 — OIDC/Keycloak login flow
# DISCOURSE_USERNAME=
# DISCOURSE_PASSWORD=

# ---------------------------------------------------------------------------
# LLM provider (OpenAI if OPENAI_API_KEY is set; otherwise Ollama)
# ---------------------------------------------------------------------------

# OpenAI path
# OPENAI_API_KEY=sk-...

# Extraction model (used by `query --index`).
# Defaults: OpenAI → gpt-4.1-mini, Ollama → qwen2.5:14b.
# Explicit values always win. Avoid gpt-5-series for indexing (latency cost).
# EXTRACTION_MODEL=

# Query model (used by `query "question"`). Empty = reuse extraction model.
# Good place to pay for reasoning at query time (e.g. gpt-5) while keeping
# the indexing model cheap and fast.
# QUERY_MODEL=

# Ollama-specific
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Embedding model (changes require `query --index --clear` to rebuild vectors)
# ---------------------------------------------------------------------------

# OpenAI embedding (dimension auto-resolves for known models)
# OPENAI_EMBED_MODEL=text-embedding-3-large
# OPENAI_EMBED_DIM=                          # only set for non-standard models

# Ollama embedding
# EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_DIM=768

# ---------------------------------------------------------------------------
# Entity-extraction gleaning passes
# ---------------------------------------------------------------------------
# 0 = extract each chunk once (cheap, baseline recall)
# 1 = one extra "what did you miss?" pass (recommended, ~+50% cost, much
#     higher recall — the single biggest quality lever)
# 2+ = diminishing returns, rapidly rising cost
GLEANING=1

# ---------------------------------------------------------------------------
# LightRAG concurrency (advanced; match to your OpenAI rate-limit tier)
# ---------------------------------------------------------------------------
# llm_model_max_async = parallel in-flight LLM calls during --index.
# max_parallel_insert = parallel document inserts.
# Unset (or 0) = fall through to provider defaults in `_get_rag`:
#   OpenAI → llm_model_max_async=8, max_parallel_insert=4
#   Ollama → llm_model_max_async=1
# Run `query --detect-limits` to probe your tier's RPM/TPM and print a
# recommended pair (typically 13/3 on OpenAI Tier 3). CLI flags
# --llm-concurrency / --parallel-insert override these per run.
# LLM_MODEL_MAX_ASYNC=
# MAX_PARALLEL_INSERT=

# ---------------------------------------------------------------------------
# Rerank (optional — improves query-time retrieval quality)
# ---------------------------------------------------------------------------
# LightRAG's rerank step re-scores retrieved chunks against the query using a
# cross-encoder model. When enabled it noticeably improves answer relevance,
# especially on `mix` mode. Leave RERANK_PROVIDER empty to disable (default;
# the "enabled but no model" warning is also suppressed).
#
# Supported providers (shipped by lightrag.rerank): jina, cohere, ali.
# For a self-hosted BAAI/bge reranker served via HuggingFace TEI or llama.cpp
# (both expose a Cohere-compatible /rerank endpoint), use `cohere` + a local
# RERANK_BASE_URL.
#
# RERANK_PROVIDER=jina                                     # jina | cohere | ali
# RERANK_MODEL=jina-reranker-v2-base-multilingual          # provider picks default if empty
# RERANK_API_KEY=
# RERANK_BASE_URL=                                         # override endpoint; empty = provider default
