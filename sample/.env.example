# Copy to sample/.env and fill in real values before running `make -C sample up`.
# sample/.env is gitignored (covered by the top-level `.env` rule); never commit
# real credentials.

# --- Discourse stack (sample/docker-compose.yml) ----------------------
DISCOURSE_HOST=localhost
DISCOURSE_PORT=4200
DISCOURSE_USERNAME=admin
DISCOURSE_PASSWORD=changeme-supersecret-please
DISCOURSE_EMAIL=admin@sample.local
DISCOURSE_DATABASE_NAME=discourse
DISCOURSE_DATABASE_USER=discourse
DISCOURSE_DATABASE_PASSWORD=changeme-db-password

# --- Discourse API key (filled in after first `make up`, by Sit 13's
#     `make api-key` target. Leave empty for now.) ---------------------
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=admin

# --- LLM provider (reused from project root convention) ---------------
# Provider auto-selected: OPENAI_API_KEY set -> OpenAI; else Ollama.
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
EXTRACTION_MODEL=
