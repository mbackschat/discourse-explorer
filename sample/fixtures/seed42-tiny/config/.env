# Per-data-dir config for the seed42-tiny fixture.
# Pin the embedding model + dimension that the committed Faiss index was built with.
# (Without this, queries against this fixture would default to text-embedding-3-large
# and dimension-mismatch the 1536d Faiss index produced by /index-and-embed.)
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
