      <data key="d0">Untranslated Music Stems</data>
      <data key="d1">issue</data>
      <data key="d2">Untranslated Music Stems refers to vocal and text-containing musical segments in the game Crown Of Brine II: The Phantom Galleon that lack proper translation or localization, affecting narrative comprehension.</data>
      <data key="d3">chunk-d3bde729c55ddd1bac32df5200454efc</data>
      <data key="d4">topic-23.json</data>
      <data key="d5">1777421761</data>
