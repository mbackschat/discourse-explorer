    <node id="Localization notes for Chapter 3: Below the Brine">
      <data key="d0">Localization notes for Chapter 3: Below the Brine</data>
      <data key="d1">topic</data>
      <data key="d2">Discussion thread in the Translations &amp; Localization category</data>
