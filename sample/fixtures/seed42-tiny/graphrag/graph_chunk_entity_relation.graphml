    <node id="Manual Stem Bundling Workaround">
      <data key="d0">Manual Stem Bundling Workaround</data>
      <data key="d1">mod</data>
      <data key="d2">Manual Stem Bundling Workaround is a solution where stems are combined into one track with audio cues to simulate stem switching due to the Doubloon SDK’s failure to load stems natively.</data>
      <data key="d3">chunk-85c16fae2334d444c9212b6502181b3d</data>
      <data key="d4">topic-34.json</data>
      <data key="d5">1777421763</data>
      <data key="d6" />
    </node>
    <node id="Audio File Format Compatibility">
      <data key="d0">Audio File Format Compatibility</data>
      <data key="d1">issue</data>
      <data key="d2">Audio File Format Compatibility is a cause of the Doubloon SDK’s failures, relating to the SDK not recognizing newer stem formats or handling stem metadata properly.</data>
      <data key="d3">chunk-85c16fae2334d444c9212b6502181b3d</data>
      <data key="d4">topic-34.json</data>
      <data key="d5">1777421763</data>
      <data key="d6" />
