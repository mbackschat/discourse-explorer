      <data key="d5">1777421714</data>
      <data key="d6" />
    </node>
    <node id="Fan Event">
      <data key="d0">Fan Event</data>
      <data key="d1">event</data>
      <data key="d2">Fan Event is a community gathering scheduled for 2025-09-25 to discuss and share content related to Crown Of Brine: Reborn, including mods, theories, walkthroughs, and contests.&lt;SEP&gt;The Fan Event is a gathering planned to celebrate Crown Of Brine III: Tides Of Forgetting, featuring community panels, lore reveals, puzzle resolutions, and announcements about remaster details and future content.</data>
      <data key="d3">chunk-e6646723530317274a426093a223bd40&lt;SEP&gt;chunk-2634b570c60c91d5cfb5be23847fbd86</data>
