    <node id="Updated Asset Pipeline">
      <data key="d0">Updated Asset Pipeline</data>
      <data key="d1">mod</data>
      <data key="d2">Updated Asset Pipeline streamlines importing and tweaking models to improve workflow and reduce iteration time, benefiting modders handling multiple assets.</data>
      <data key="d3">chunk-f9c686196637ac63107dfb19abf0492f</data>
      <data key="d4">topic-32.json</data>
      <data key="d5">1777421742</data>
      <data key="d6" />
