    <node id="Asset Manifest">
      <data key="d0">Asset Manifest</data>
      <data key="d1">guide</data>
      <data key="d2">The asset manifest is a new file listing required sprite files explicitly as part of the remaster's updated asset pipeline that must be maintained for proper sprite loading.</data>
      <data key="d3">chunk-96f190c786ce4257203c3d6b66d025a4</data>
      <data key="d4">topic-14.json</data>
      <data key="d5">1777421626</data>
      <data key="d6" />
