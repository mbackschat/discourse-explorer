    <node id="Animation Framework">
      <data key="d0">Animation Framework</data>
      <data key="d1">mod</data>
      <data key="d2">The Animation Framework update optimizes character movement control for more natural gestures and improves particle effects for enhanced spellcasting sequences without losing performance.</data>
      <data key="d3">chunk-f9c686196637ac63107dfb19abf0492f</data>
      <data key="d4">topic-32.json</data>
