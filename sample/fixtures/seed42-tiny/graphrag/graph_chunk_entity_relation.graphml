    <node id="Music Stem Loading Issue">
      <data key="d0">Music Stem Loading Issue</data>
      <data key="d1">issue</data>
      <data key="d2">The Music Stem Loading Issue refers to the problem where the Doubloon SDK fails to recognize or play separate music stems, limiting audio customization in mods for game-1 and game-2.</data>
      <data key="d3">chunk-85c16fae2334d444c9212b6502181b3d</data>
      <data key="d4">topic-34.json</data>
      <data key="d5">1777421763</data>
