    <node id="Stem Metadata">
      <data key="d0">Stem Metadata</data>
      <data key="d1">issue</data>
      <data key="d2">Stem Metadata refers to the information embedded in audio stem files that the Doubloon SDK fails to properly handle, contributing to the music stem loading issue.</data>
      <data key="d3">chunk-85c16fae2334d444c9212b6502181b3d</data>
      <data key="d4">topic-34.json</data>
      <data key="d5">1777421763</data>
      <data key="d6" />
    </node>
    <node id="Music Stems Loading Issue">
      <data key="d0">Music Stems Loading Issue</data>
      <data key="d1">issue</data>
      <data key="d2">A problem within the Doubloon SDK where music stems fail to load consistently, causing issues with audio layering and remixing across game-1 and game-2 projects.</data>
      <data key="d3">chunk-07f4ec6e0ca4202e8d8347800628e9b8</data>
      <data key="d4">topic-34.json</data>
      <data key="d5">1777421763</data>
      <data key="d6" />
    </node>
