    <node id="Doubloon SDK Update">
      <data key="d0">Doubloon SDK Update</data>
      <data key="d1">mod</data>
      <data key="d2">Doubloon SDK Update is a software development kit update focusing on features for remaster projects including a new flexible lighting system, expanded scripting API, updated asset pipeline, and animation framework enhancements.</data>
      <data key="d3">chunk-f9c686196637ac63107dfb19abf0492f</data>
      <data key="d4">topic-32.json</data>
      <data key="d5">1777421742</data>
      <data key="d6" />
    </node>
    <node id="Lighting System">
      <data key="d0">Lighting System</data>
      <data key="d1">mod</data>
      <data key="d2">The Lighting System is a component of the Doubloon SDK Update featuring more flexibility, real-time shadows, and ambient occlusion options that improve visuals and texture details.</data>
      <data key="d3">chunk-f9c686196637ac63107dfb19abf0492f</data>
      <data key="d4">topic-32.json</data>
      <data key="d5">1777421742</data>
      <data key="d6" />
