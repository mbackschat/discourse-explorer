# Local-only sample-stack credentials. Not for production.
# This .env is gitignored (top-level .env rule covers it).
# Stack is brought up briefly for the seed42-tiny fixture re-bake then nuked.

DISCOURSE_HOST=localhost
DISCOURSE_PORT=4200
DISCOURSE_USERNAME=admin
DISCOURSE_PASSWORD=SampleAdminDev1234
DISCOURSE_EMAIL=admin@sample.local

DISCOURSE_DATABASE_USER=discourse
DISCOURSE_DATABASE_PASSWORD=SampleDbDev1234
DISCOURSE_DATABASE_NAME=discourse_dev

# Seeder uses these for the live push (set by `make api-key` after stack is up).
DISCOURSE_API_USERNAME=admin
